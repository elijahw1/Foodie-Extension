{
    "manifest_version": 3,
    "name": "My Email Extension",
    "version": "0.0",
    "action" : {
        "default_popup" : "hello.html",
        "default_icon" : "images/icon.png"
    },
    "oauth2": {
        "client_id": "774476139912-0rpgu7pkdvgsfkr7lumn1dhtt5jdouaq.apps.googleusercontent.com",
        "scopes": ["https://www.googleapis.com/auth/gmail.addons.current.message.action", 
                  "https://www.googleapis.com/auth/gmail.addons.current.message.readonly"   
          ]
      },
      "permissions": [
          "identity",
          "activeTab", 
          "scripting"
        ],
      "background": {
        "service_worker": "background.js"
      },
      "commands" : {
          "_execute_action" : {
              "suggested_key" : {
                  "default" : "Ctrl+B",
                  "mac" : "Command+B"
              }
          }
      }
}
  
  